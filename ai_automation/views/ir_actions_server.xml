<odoo>
    <record model="ir.ui.view" id="ir_actions_server_form_view">
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form" />
        <field name="arch" type="xml">
            <group name="action_content" position="inside">
                <field name="ai_connection_id" invisible="state != 'ai_oca'" />
                <field
                    name="ai_tool_ids"
                    invisible="state != 'ai_oca'"
                    widget="many2many_tags"
                    domain="['|', ('model_id', '=', model_id), ('kind', 'in', ['generic', 'generic_model'])]"
                />
                <field name="mailing_model_real" invisible="1" />
                <field name="ai_system_prompt" invisible="state != 'ai_oca'" />
                <field
                    name="ai_prompt"
                    widget="html"
                    invisible="state != 'ai_oca'"
                    class="oe-bordered-editor"
                    options="{'style-inline': true, 'codeview': true, 'dynamic_placeholder': true, 'dynamic_placeholder_model_reference_field': 'mailing_model_real'}"
                />
                <field name="ai_result_action" invisible="state != 'ai_oca'" />
                <field
                    name="ai_update_record_field_id"
                    invisible="state != 'ai_oca' or ai_result_action != 'update_record'"
                />
            </group>
        </field>
    </record>
</odoo>
